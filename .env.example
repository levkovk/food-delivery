# Пароли для локального запуска в Docker Compose. Скопируйте файл в .env
# и замените значения. В Kubernetes те же значения хранятся в Secret.
POSTGRES_PASSWORD=postgres-dev-password
GATEWAY_DB_PASSWORD=gateway-dev-password
ORDER_DB_PASSWORD=order-dev-password
RESTAURANT_DB_PASSWORD=restaurant-dev-password
PAYMENT_DB_PASSWORD=payment-dev-password
COURIER_DB_PASSWORD=courier-dev-password
JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
ADMIN_PASSWORD=admin-dev-password
OPERATOR_PASSWORD=operator-dev-password
GRAFANA_PASSWORD=grafana-dev-password
